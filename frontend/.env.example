# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Contract Addresses — Base Sepolia
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_RESOLVER_ADDRESS=

# Contract Addresses — BSC Testnet (deployed 2026-09-29)
NEXT_PUBLIC_REGISTRY_ADDRESS_BSC_TESTNET=0x5D0c9D417E854b75b663869AfB53761Ed33f395f
NEXT_PUBLIC_RESOLVER_ADDRESS_BSC_TESTNET=0xF769DD73Bf00457132E7f9F413720EC314AB20eC

# Network (default chain untuk UI)
