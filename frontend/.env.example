# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Contract Addresses — Base Sepolia
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_RESOLVER_ADDRESS=

# Contract Addresses — BSC Testnet (isi setelah deploy)
NEXT_PUBLIC_REGISTRY_ADDRESS_BSC_TESTNET=
NEXT_PUBLIC_RESOLVER_ADDRESS_BSC_TESTNET=

# Network (default chain untuk UI)
NEXT_PUBLIC_CHAIN_ID=97

# Custom RPC (opsional, fallback ke public RPC)
NEXT_PUBLIC_BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
NEXT_PUBLIC_BSC_RPC=https://bsc-dataseed.bnbchain.org
